DATABASE_URL=postgresql://postgres:postgres@postgres:5432/poker
REDIS_URL=redis://redis:6379
# Public single-host defaults for https://YOUR_DOMAIN.dev.
# Override these to localhost values if you want direct local-only development.
NEXT_PUBLIC_API_BASE_URL=/api
GAME_INTERNAL_BASE_URL=http://game:4200
NEXT_PUBLIC_GAME_HTTP_URL=/game
NEXT_PUBLIC_GAME_WS_URL=/game
POKER_BRAND_NAME=Poker
# House rules are configured in config/house-rules.json.
API_PORT=4100
GAME_PORT=4200
WORKER_CONCURRENCY=2
WORKER_POLL_INTERVAL_MS=30000
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=devsecretdevsecretdevsecretdevse
LIVEKIT_WS_URL=/livekit
LIVEKIT_NODE_IP=YOUR_DOMAIN.dev
# Public TURN/TLS relay for restrictive networks.
# Router/firewall rules for the current config:
#   required: 50000-50100/udp (direct SFU media)
#   required: 51000-51100/udp (TURN relay media)
#   required: 5349/tcp        (TURN/TLS entry point)
#   optional: 3478/udp        (TURN/UDP + STUN)
# For a direct public 5349/tcp forward to the poker host, copy the wildcard
# certs to:
#   certs/domain.cert.pem
#   certs/private.key.pem
# Then set:
#   LIVEKIT_TURN_DOMAIN=turn-YOUR_DOMAIN.dev
#   LIVEKIT_TURN_TLS_PORT=5349
#   LIVEKIT_TURN_CERT=/etc/livekit-certs/domain.cert.pem
#   LIVEKIT_TURN_KEY=/etc/livekit-certs/private.key.pem
# If your reverse proxy terminates TURN/TLS instead, set:
#   LIVEKIT_TURN_EXTERNAL_TLS=true
# and leave LIVEKIT_TURN_CERT / LIVEKIT_TURN_KEY empty.
LIVEKIT_TURN_DOMAIN=
LIVEKIT_TURN_TLS_PORT=
LIVEKIT_TURN_EXTERNAL_TLS=
LIVEKIT_TURN_CERT=
LIVEKIT_TURN_KEY=
# Room-creation policy:
# When enabled, only the configured admin username can create tables.
ROOM_CREATION_ADMIN_ONLY=false
ROOM_CREATION_ADMIN_USERNAME=admin
ROOM_CREATION_ADMIN_PASSWORD=change-me-before-production
